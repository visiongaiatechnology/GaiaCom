# GaiaCom local development environment template.
# Production operators must use `gaiacom-backend setup`; never copy test secrets.

GAIACOM_DEV_MODE=true
GAIACOM_COOKIE_SECURE=false
GAIACOM_SERVER_NAME=localhost
SERVER_PORT=8080

DB_DRIVER=sqlite
DB_PATH=gaiacom.db

# Development-only values. Production setup generates independent random secrets.
GAIACOM_JWT_SECRET=TEST_ONLY_DO_NOT_USE_IN_PRODUCTION_replace_with_32_byte_random_secret
GAIACOM_SHIELD_SECRET=TEST_ONLY_DO_NOT_USE_IN_PRODUCTION_replace_with_32_byte_random_secret
GAIACOM_METRICS_TOKEN=TEST_ONLY_DO_NOT_USE_IN_PRODUCTION_replace_with_32_byte_random_secret
GAIACOM_SERVER_PRIVATE_KEY=
GAIACOM_TRUSTMESH_EPOCH_SECRET=

OPEN_REGISTRATION=true
GAIACOM_TRUSTED_PROXY_CIDRS=

# Legacy SMTP bridge. Production requires authenticated TLS.
GAIACOM_SMTP_HOST=smtp.example.com
GAIACOM_SMTP_PORT=587
GAIACOM_SMTP_TLS_MODE=starttls
GAIACOM_SMTP_USERNAME=TEST_ONLY_RELAY_USERNAME
GAIACOM_SMTP_PASSWORD=TEST_ONLY_RELAY_PASSWORD
GAIACOM_SMTP_FROM=GaiaCOM <noreply@example.com>
GAIACOM_SMTP_INGEST_TOKEN=TEST_ONLY_REPLACE_WITH_RANDOM_32_BYTE_TOKEN
