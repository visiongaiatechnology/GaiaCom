GAIACOM_JWT_SECRET=replace-with-at-least-32-random-bytes
GAIACOM_SHIELD_SECRET=replace-with-at-least-32-random-bytes
GAIACOM_METRICS_TOKEN=replace-with-at-least-32-random-bytes
GAIACOM_SERVER_NAME=localhost
GAIACOM_SERVER_PRIVATE_KEY=
GAIACOM_DEV_MODE=true
GAIACOM_COOKIE_SECURE=false
SERVER_PORT=8080
DB_DRIVER=sqlite
DB_PATH=gaiacom.db

# Comma-separated reverse-proxy CIDRs. Leave empty when the backend is directly exposed.
GAIACOM_TRUSTED_PROXY_CIDRS=
